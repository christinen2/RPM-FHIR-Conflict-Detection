@prefix : <http://prototype/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tmr: <http://tmr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:graph_Heartfailure {
    :Heartfailure a :PlanDefinition ;
        rdfs:label "Testing_Heartfailure-PlanDefinition" ;
        :hasAction :Action_HEART-FAILURE-BP-HYPERTENSION,
            :Action_Promise-19 ;
        :status true .

    :Action_HEART-FAILURE-BP-HYPERTENSION a :Action ;
        rdfs:label "Default_Threshold-BP_HYPERTENSION-HeartFailure" ;
        :activityDefinition :ActivityDefinition_HEART-FAILURE-BP-HYPERTENSION .

    :Action_Promise-19 a :Action ;
        rdfs:label "Promise-19" ;
        :hasTiming _:Nec344df7efe74aff8edd4e76872f64c2 .

    :ActivityDefinition_HEART-FAILURE-BP-HYPERTENSION a :ActivityDefinition ;
        rdfs:label "Hypertension" ;
        :requiresObservation :ObservationDefinition_MDC-PRESS-BLD-NONINV-SYS ;
        :threshold :Interval_asap-HEART-FAILURE-BP-HYPERTENSION,
            :Interval_urgent-HEART-FAILURE-BP-HYPERTENSION .

    :Interval_asap-HEART-FAILURE-BP-HYPERTENSION a tmr:ThresholdInterval ;
        :higherInclusive false ;
        :lowerBound 1.79e+02 ;
        :lowerInclusive true ;
        :priority "asap" ;
        :upperBound "INF"^^xsd:double .

    :Interval_urgent-HEART-FAILURE-BP-HYPERTENSION a tmr:ThresholdInterval ;
        :higherInclusive false ;
        :lowerBound 9.9e+01 ;
        :lowerInclusive true ;
        :priority "urgent" ;
        :upperBound 1.79e+02 .

    :ObservationDefinition_MDC-PRESS-BLD-NONINV-SYS a :ObservationDefinition ;
        rdfs:label "MDC-PRESS-BLD-NONINV-SYS" .

    _:Nec344df7efe74aff8edd4e76872f64c2 a :Timing ;
        :frequency 1 ;
        :period 1.0 ;
        :periodUnit "a"@a .
}

